{
  "name": "zh-lipsync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "中文配音自动口型系统：拼音音素切分、音频强制对齐、口型曲线生成与三维预览",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx src/cli/cli.ts",
    "generate": "tsx src/cli/cli.ts generate-samples",
    "batch": "tsx src/cli/cli.ts batch",
    "bench": "tsx src/cli/cli.ts benchmark"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/three": "^0.169.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.5"
  }
}
